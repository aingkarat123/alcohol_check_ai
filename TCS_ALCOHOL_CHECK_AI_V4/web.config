<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="5242880" />
        <fileExtensions>
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".py" allowed="false" />
        </fileExtensions>
        <hiddenSegments>
          <add segment="config" />
          <add segment="database" />
          <add segment="docs" />
          <add segment="includes" />
          <add segment="ocr_service" />
          <add segment="storage" />
          <add segment="tests" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(self), microphone=()" />
      </customHeaders>
    </httpProtocol>
    <httpErrors errorMode="DetailedLocalOnly" />
  </system.webServer>
  <system.web>
    <httpRuntime maxRequestLength="5120" executionTimeout="30" />
  </system.web>
</configuration>
